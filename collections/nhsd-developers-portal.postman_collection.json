									"pm.test(\"Check if open now\", function () {",
									"    const responseJson = pm.response.json();",
									"",
									"    var reqValue = decodeURI(pm.request.url.query.get('openNow')).toLowerCase()",
									"",
									"    if(reqValue == \"true\"){",
									"        reqValue = \"current-status|open\"",
									"    }else{",
									"        reqValue = \"current-status|closed\"",
									"    }",
									"",
									"    var entities = responseJson.entry;",
									"    for(entity of entities){",
									"        var respValues = [];",
									"",
									"        var items = entity.resource.meta.extension",
									"        for(item of items){",
									"            var system = item.extension[0].url.toLowerCase()",
									"            var code = item.extension[0].valueString.toLowerCase()",
									"            ",
									"            respValues.push(system + \"|\" + code);",
									"        }",
									"",
									"        pm.expect(respValues).includes(reqValue);",
