								"exec": [
									"pm.test(\"Check identifier matches\", function () {",
									"    var startUri = 'nhsd:/reference/common/organisationIdentifierType/'",
									"",
									"    const responseJson = pm.response.json();",
									"",
									"    var value = decodeURI(pm.request.url.query.get('identifier'))",
									"",
									"    var entities = responseJson.entry;",
									"    for(entity of entities){",
									"        var valuesArray = [];",
									"",
									"        var identifiers = entity.resource.identifier",
									"        for(identifier of identifiers){",
									"            var code = identifier.type.coding[0].code.toLowerCase()",
									"            var resValue = identifier.value",
									"            valuesArray.push(startUri + code + \"|\" + resValue);",
									"        }",
									"",
									"        pm.expect(valuesArray).includes(value);",
									"    }",
