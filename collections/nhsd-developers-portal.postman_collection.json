					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Correctly returned an access token\", function () {",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson).to.haveOwnProperty(\"accessToken\");",
									"",
									"    token = responseJson.accessToken",
									"    pm.collectionVariables.set(\"token\", \"Bearer \" + token);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
